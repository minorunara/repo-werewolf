<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Minorunara_Werewolf</AssemblyName>
    <RootNamespace>Werewolf</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputPath>out\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <RepoPath Condition="'$(RepoPath)' == ''">../REPO_Data/Managed/</RepoPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">../BepInEx/core/</BepInExCorePath>
    <DeployPath Condition="'$(DeployPath)' == ''"></DeployPath>
  </PropertyGroup>

  <Target Name="Deploy" AfterTargets="Build"
          Condition="'$(SkipDeploy)' != 'true' and '$(DeployPath)' != ''">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DeployPath)" />
    <Message Text="Deployed: $(DeployPath)$(AssemblyName).dll" Importance="high" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*.png" />
    <EmbeddedResource Include="Assets\**\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(RepoPath)*Unity*" Private="false" />
    <Reference Include="$(RepoPath)Assembly-CSharp*" Private="false" />
    <Reference Include="$(RepoPath)Photon*" Private="false" />
    <Reference Include="$(BepInExCorePath)BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)0Harmony.dll" Private="false" />
  </ItemGroup>

</Project>
