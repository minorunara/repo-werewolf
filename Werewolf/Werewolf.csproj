<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Minorunara_Werewolf</AssemblyName>
    <RootNamespace>Werewolf</RootNamespace>
    <WerewolfVersion Condition="'$(WerewolfVersion)' == ''">1.1.0</WerewolfVersion>
    <Version>$(WerewolfVersion)</Version>
    <AssemblyVersion>$(WerewolfVersion).0</AssemblyVersion>
    <FileVersion>$(WerewolfVersion).0</FileVersion>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputPath>out\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="GenerateWerewolfBuildInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_WerewolfBuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <_WerewolfBuildInfoLines Include="namespace Werewolf" />
      <_WerewolfBuildInfoLines Include="{" />
      <_WerewolfBuildInfoLines Include="    internal static class WerewolfBuildInfo" />
      <_WerewolfBuildInfoLines Include="    {" />
      <_WerewolfBuildInfoLines Include="        public const string Version = &quot;$(WerewolfVersion)&quot;%3B" />
      <_WerewolfBuildInfoLines Include="    }" />
      <_WerewolfBuildInfoLines Include="}" />
      <Compile Include="$(IntermediateOutputPath)WerewolfBuildInfo.g.cs" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)WerewolfBuildInfo.g.cs"
      Lines="@(_WerewolfBuildInfoLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

  <PropertyGroup>
    <RepoPath Condition="'$(RepoPath)' == ''">../REPO_Data/Managed/</RepoPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">../BepInEx/core/</BepInExCorePath>
    <DeployPath Condition="'$(DeployPath)' == ''"></DeployPath>
  </PropertyGroup>

  <Target Name="Deploy" AfterTargets="Build"
          Condition="'$(SkipDeploy)' != 'true' and '$(DeployPath)' != ''">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DeployPath)" />
    <Message Text="Deployed: $(DeployPath)$(AssemblyName).dll" Importance="high" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*.png" />
    <EmbeddedResource Include="Assets\**\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(RepoPath)*Unity*" Private="false" />
    <Reference Include="$(RepoPath)Assembly-CSharp*" Private="false" />
    <Reference Include="$(RepoPath)Photon*" Private="false" />
    <Reference Include="$(BepInExCorePath)BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)0Harmony.dll" Private="false" />
  </ItemGroup>

</Project>
